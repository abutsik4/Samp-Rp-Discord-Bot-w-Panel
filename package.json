{
  "name": "jepsencloud-bot-panel",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development node src/index.js",
    "check": "node --check src/index.js",
    "make:hash": "node scripts/make-password-hash.js",
    "audit:user": "node scripts/audit-user.js",
    "validate:messages": "node scripts/validate-message-counts.js",
    "backfill:safe": "node scripts/safe-backfill.js",
    "test": "node --test \"src/**/*.test.js\"",
    "test:integration": "PAGE_CACHE_LOG=0 node scripts/test-analytics-integration.js",
    "test:all": "npm run test && npm run test:integration"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "brain.js": "^2.0.0-beta.24",
    "cheerio": "^1.1.2",
    "connect-sqlite3": "^0.9.15",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.1",
    "helmet": "^7.1.0",
    "natural": "^7.1.0",
    "sqlite3": "^5.1.7"
  }
}
