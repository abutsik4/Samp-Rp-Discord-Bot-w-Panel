        <button class="btn btn-primary w-full" type="submit" style="margin-top: 20px;">Create User</button>
      </form>
    </div>
  </div>

  <!-- Reset Password Modal -->
  <div id="resetPasswordModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeResetPasswordModal()">&times;</span>
      <h2 class="modal-title">🔑 Reset User Password</h2>
      <p style="color: var(--text-muted); margin-bottom: 20px;">Set a new password for user: <strong id="resetUsername"></strong></p>
      <form method="post" action="/panel/users/reset-password">
        <input type="hidden" name="username" id="resetUsernameInput" />
        <div class="form-group">
          <label>New Password</label>
          <input name="newPassword" type="password" required minlength="8" placeholder="min 8 characters" />
        </div>
        <div class="form-group">
          <label>Confirm Password</label>
          <input name="confirmPassword" type="password" required minlength="8" placeholder="confirm password" />
        </div>
        <button class="btn btn-primary w-full" type="submit">Reset Password</button>
      </form>
    </div>
  </div>

  <!-- Permissions Modal -->
  <div id="permissionsModal" class="modal">
    <div class="modal-content" style="max-width: 600px;">
      <span class="close" onclick="closePermissionsModal()">&times;</span>
      <h2 class="modal-title">⚙️ User Permissions</h2>
      <p style="color: var(--text-muted); margin-bottom: 20px;">Configuring permissions for: <strong id="permissionsUsername"></strong></p>
      <form method="post" action="/panel/users/update-permissions" id="permissionsForm">
        <input type="hidden" name="username" id="permissionsUsernameInput" />
        
        <div class="permissions-grid" id="editPermissionsGrid">
          <label class="permission-item" data-perm="view_dashboard">
            <input type="checkbox" name="perm_view_dashboard" value="1" hidden>
            <div class="permission-toggle"></div>
            <span class="permission-label">View Dashboard</span>
          </label>
          <label class="permission-item" data-perm="send_messages">
            <input type="checkbox" name="perm_send_messages" value="1" hidden>
            <div class="permission-toggle"></div>
            <span class="permission-label">Send Messages</span>
          </label>
          <label class="permission-item" data-perm="view_analytics">
            <input type="checkbox" name="perm_view_analytics" value="1" hidden>
            <div class="permission-toggle"></div>
            <span class="permission-label">View Analytics</span>
          </label>
          <label class="permission-item" data-perm="manage_bot">
            <input type="checkbox" name="perm_manage_bot" value="1" hidden>
            <div class="permission-toggle"></div>
            <span class="permission-label">Manage Bot Settings</span>
          </label>
          <label class="permission-item" data-perm="edit_library">
            <input type="checkbox" name="perm_edit_library" value="1" hidden>
            <div class="permission-toggle"></div>
            <span class="permission-label">Edit Message Library</span>
          </label>
          <label class="permission-item" data-perm="view_debug">
            <input type="checkbox" name="perm_view_debug" value="1" hidden>
            <div class="permission-toggle"></div>
            <span class="permission-label">View Debug Logs</span>
          </label>
          <label class="permission-item" data-perm="schedule_messages">
            <input type="checkbox" name="perm_schedule_messages" value="1" hidden>
            <div class="permission-toggle"></div>
            <span class="permission-label">Schedule Messages</span>
          </label>
          <label class="permission-item" data-perm="export_data">
            <input type="checkbox" name="perm_export_data" value="1" hidden>
            <div class="permission-toggle"></div>
            <span class="permission-label">Export Data</span>
          </label>
        </div>
        
        <div style="display: flex; gap: 12px; margin-top: 24px;">
          <button type="button" class="btn btn-secondary" style="flex: 1;" onclick="selectAllPermissions()">Select All</button>
          <button type="button" class="btn btn-secondary" style="flex: 1;" onclick="clearAllPermissions()">Clear All</button>
        </div>
        
        <button class="btn btn-primary w-full" type="submit" style="margin-top: 12px;">Save Permissions</button>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/locomotive-scroll@4.1.4/dist/locomotive-scroll.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  <script src="/public/snow.js"></script>
  
  <!-- Global Error Tracking & Debug -->
  <script>
    (function() {
      window.__panelErrorLog = [];
      const MAX_ERROR_LOG = 50;
      
      function logError(error, context = {}) {
        const entry = {
          time: new Date().toISOString(),
          message: error?.message || String(error),
          stack: error?.stack || null,
          context,
          url: location.href
        };
        window.__panelErrorLog.unshift(entry);
        if (window.__panelErrorLog.length > MAX_ERROR_LOG) window.__panelErrorLog.pop();
        console.error('[Panel Error]', entry);
        return entry;
      }
      
      window.panelLogError = logError;
      window.addEventListener('error', (e) => logError(e.error || e.message, { type: 'uncaught' }));
      window.addEventListener('unhandledrejection', (e) => logError(e.reason, { type: 'unhandledrejection' }));
      
      // Toast notifications
      window.showPanelToast = function(message, type = 'info', duration = 4000) {
        let container = document.getElementById('panelToastContainer');
        if (!container) {
          container = document.createElement('div');
          container.id = 'panelToastContainer';
          container.style.cssText = 'position:fixed;top:20px;right:20px;z-index:25000;display:flex;flex-direction:column;gap:10px;max-width:380px;';
          document.body.appendChild(container);
        }
        
        const colors = {
          success: { bg: 'color-mix(in srgb, var(--pearl-aqua) 20%, var(--bg-card))', border: 'var(--pearl-aqua)', icon: '✅' },
          error: { bg: 'color-mix(in srgb, var(--bubblegum-pink) 20%, var(--bg-card))', border: 'var(--bubblegum-pink)', icon: '❌' },
          warning: { bg: 'color-mix(in srgb, #f5c77e 20%, var(--bg-card))', border: '#f5c77e', icon: '⚠️' },
          info: { bg: 'var(--bg-card)', border: 'var(--border)', icon: '💡' }
        };
        const style = colors[type] || colors.info;
        
        const toast = document.createElement('div');
        toast.style.cssText = 'background:' + style.bg + ';border:1px solid ' + style.border + ';border-radius:12px;padding:14px 18px;color:var(--text);font-size:14px;display:flex;align-items:center;gap:10px;box-shadow:0 8px 32px rgba(0,0,0,0.3);backdrop-filter:blur(8px);';
        toast.innerHTML = '<span style="font-size:18px;">' + style.icon + '</span><span style="flex:1;">' + message + '</span><button style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:18px;" onclick="this.parentElement.remove()">×</button>';
        container.appendChild(toast);
        setTimeout(() => toast.remove(), duration);
      };
      
      // Debug console (Ctrl+Shift+D)
      window.debugLog = function(msg, type = 'info') { console.log('[Debug][' + type + ']', msg); };
      document.addEventListener('keydown', (e) => {
        if (e.ctrlKey && e.shiftKey && (e.key === 'd' || e.key === 'D')) {
          e.preventDefault();
          console.log('Error Log:', window.__panelErrorLog);
          window.showPanelToast('Check console for error log (Ctrl+Shift+D)', 'info');
        }
      });
    })();
  </script>
  
  <script>
    // Initialize Locomotive Scroll
    const locoScroll = new LocomotiveScroll({
      el: document.querySelector('[data-scroll-container]'),
      smooth: true,
      lerp: 0.075,
      multiplier: 0.8,
      smartphone: { smooth: true },
      tablet: { smooth: true }
    });

    gsap.registerPlugin(ScrollTrigger);
    locoScroll.on('scroll', ScrollTrigger.update);
    ScrollTrigger.scrollerProxy('[data-scroll-container]', {
      scrollTop(value) {
        return arguments.length ? locoScroll.scrollTo(value, 0, 0) : locoScroll.scroll.instance.scroll.y;
      },
      getBoundingClientRect() {
        return { top: 0, left: 0, width: window.innerWidth, height: window.innerHeight };
      },
      pinType: document.querySelector('[data-scroll-container]').style.transform ? 'transform' : 'fixed'
    });
    ScrollTrigger.addEventListener('refresh', () => locoScroll.update());
    ScrollTrigger.refresh();

    locoScroll.on('scroll', (args) => {
      const progress = (args.scroll.y / (args.limit.y || 1)) * 100;
      document.getElementById('scrollProgressBar').style.width = progress + '%';
    });

    // Mobile sidebar
    const toggle = document.getElementById('sidebarToggle');
    const overlay = document.getElementById('sidebarOverlay');
    const sidebar = document.getElementById('sidebarNav');
    toggle.addEventListener('click', () => {
      sidebar.classList.toggle('open');
      overlay.classList.toggle('open');
    });
    overlay.addEventListener('click', () => {
      sidebar.classList.remove('open');
      overlay.classList.remove('open');
    });

    // Permission item toggle behavior
    document.querySelectorAll('.permission-item').forEach(item => {
      item.addEventListener('click', function(e) {
        if (e.target.tagName !== 'INPUT') {
          const checkbox = this.querySelector('input[type="checkbox"]');
          if (checkbox) {
            checkbox.checked = !checkbox.checked;
            this.classList.toggle('active', checkbox.checked);
          }
        }
      });
    });
    
    // Modal tab switching
    document.querySelectorAll('.modal-tab').forEach(tab => {
      tab.addEventListener('click', function() {
        const targetPanel = this.dataset.tab;
        const modal = this.closest('.modal-content');
        
        modal.querySelectorAll('.modal-tab').forEach(t => t.classList.remove('active'));
        modal.querySelectorAll('.modal-tab-panel').forEach(p => p.classList.remove('active'));
        
        this.classList.add('active');
        modal.querySelector(`[data-panel="${targetPanel}"]`).classList.add('active');
      });
    });

    // Modal functions
    function showCreateUserModal() {
      document.getElementById('createUserModal').style.display = 'block';
      togglePermissionsVisibility();
    }

    function closeCreateUserModal() {
      document.getElementById('createUserModal').style.display = 'none';
    }
    
    function togglePermissionsVisibility() {
      const role = document.getElementById('createUserRole').value;
      const permPanel = document.getElementById('createPermissionsPanel');
      const permTab = document.querySelector('.modal-tab[data-tab="permissions"]');
      
      if (role === 'admin') {
        permPanel.style.opacity = '0.5';
        permPanel.style.pointerEvents = 'none';
        permTab.style.opacity = '0.5';
      } else {
        permPanel.style.opacity = '1';
        permPanel.style.pointerEvents = 'auto';
        permTab.style.opacity = '1';
      }
    }

    function showResetPasswordModal(username) {
      document.getElementById('resetUsername').textContent = username;
      document.getElementById('resetUsernameInput').value = username;
      document.getElementById('resetPasswordModal').style.display = 'block';
    }

    function closeResetPasswordModal() {
      document.getElementById('resetPasswordModal').style.display = 'none';
    }
    
    function showPermissionsModal(username, permissionsJson) {
      document.getElementById('permissionsUsername').textContent = username;
      document.getElementById('permissionsUsernameInput').value = username;
      
      // Reset all permissions
      document.querySelectorAll('#editPermissionsGrid .permission-item').forEach(item => {
        item.classList.remove('active');
        const checkbox = item.querySelector('input[type="checkbox"]');
        if (checkbox) checkbox.checked = false;
      });
      
      // Parse and apply permissions
      try {
        const permissions = JSON.parse(permissionsJson || '{}');
        Object.keys(permissions).forEach(perm => {
          if (permissions[perm]) {
            const item = document.querySelector(`#editPermissionsGrid [data-perm="${perm}"]`);
            if (item) {
              item.classList.add('active');
              const checkbox = item.querySelector('input[type="checkbox"]');
              if (checkbox) checkbox.checked = true;
            }
          }
        });
      } catch (e) {
        console.error('Error parsing permissions:', e);
      }
      
      document.getElementById('permissionsModal').style.display = 'block';
    }
    
    function closePermissionsModal() {
      document.getElementById('permissionsModal').style.display = 'none';
    }
    
    function selectAllPermissions() {
      document.querySelectorAll('#editPermissionsGrid .permission-item').forEach(item => {
        item.classList.add('active');
        const checkbox = item.querySelector('input[type="checkbox"]');
        if (checkbox) checkbox.checked = true;
      });
    }
    
    function clearAllPermissions() {
      document.querySelectorAll('#editPermissionsGrid .permission-item').forEach(item => {
        item.classList.remove('active');
        const checkbox = item.querySelector('input[type="checkbox"]');
        if (checkbox) checkbox.checked = false;
      });
    }

    window.onclick = function(event) {
      const modals = ['createUserModal', 'resetPasswordModal', 'permissionsModal'];
      modals.forEach(modalId => {
        const modal = document.getElementById(modalId);
        if (event.target === modal) modal.style.display = 'none';
      });
    }

    function confirmDelete(username) {
      if (confirm(`Are you sure you want to delete user "${username}"?`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/panel/users/delete';
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'username';
        input.value = username;
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
      }
    }

    function makeAdmin(username) {
      if (confirm(`Grant admin privileges to "${username}"? This user will have all permissions.`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/panel/users/update-role';
        const inputUser = document.createElement('input');
        inputUser.type = 'hidden';
        inputUser.name = 'username';
        inputUser.value = username;
        const inputRole = document.createElement('input');
        inputRole.type = 'hidden';
        inputRole.name = 'role';
        inputRole.value = 'admin';
        form.appendChild(inputUser);
        form.appendChild(inputRole);
        document.body.appendChild(form);
        form.submit();
      }
    }

    function makeUser(username) {
      if (confirm(`Revoke admin privileges from "${username}"? You can still configure specific permissions after.`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/panel/users/update-role';
        const inputUser = document.createElement('input');
        inputUser.type = 'hidden';
        inputUser.name = 'username';
        inputUser.value = username;
        const inputRole = document.createElement('input');
        inputRole.type = 'hidden';
        inputRole.name = 'role';
        inputRole.value = 'user';
        form.appendChild(inputUser);
        form.appendChild(inputRole);
        document.body.appendChild(form);
        form.submit();
      }
    }
    
    // Keyboard shortcut: Ctrl+Shift+N to create new user
    document.addEventListener('keydown', function(e) {
      if (e.ctrlKey && e.shiftKey && e.key === 'N') {
        e.preventDefault();
        showCreateUserModal();
      }
      if (e.key === 'Escape') {
        closeCreateUserModal();
        closeResetPasswordModal();
        closePermissionsModal();
      }
    });
  </script>
</body>
</html>
