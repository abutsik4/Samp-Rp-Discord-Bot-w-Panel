<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>User Management — JepsenCloud Panel</title>
  <link rel="stylesheet" href="/shared.css" />
  <style>
    .users-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    .users-table th {
      background: rgba(167, 139, 250, 0.1);
      padding: 12px;
      text-align: left;
      border-bottom: 2px solid var(--border-color);
      font-weight: 600;
    }
    .users-table td {
      padding: 12px;
      border-bottom: 1px solid var(--border-color);
    }
    .users-table tr:hover {
      background: rgba(167, 139, 250, 0.05);
    }
    .role-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
    }
    .role-admin {
      background: rgba(239, 68, 68, 0.2);
      color: #f87171;
    }
    .role-user {
      background: rgba(59, 130, 246, 0.2);
      color: #60a5fa;
    }
    .btn-small {
      padding: 6px 12px;
      font-size: 13px;
      margin-right: 6px;
    }
    .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(4px);
    }
    .modal-content {
      background-color: var(--bg-dark);
      margin: 10% auto;
      padding: 30px;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      width: 90%;
      max-width: 500px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }
    .close {
      color: var(--text-muted);
      float: right;
      font-size: 28px;
      font-weight: bold;
      cursor: pointer;
    }
    .close:hover {
      color: var(--text-primary);
    }
  </style>
</head>
<body>
  <div class="page-container">
    <nav class="navbar">
      <div class="navbar-brand">
        <a href="/">🎮 JepsenCloud Panel</a>
      </div>
      <div class="navbar-links">
        <span>👤 <%= username %> (<%= userRole %>)</span>
        <a href="/change-password">🔐 Change Password</a>
        <form method="post" action="/logout" style="display:inline">
          <button class="btn btn-secondary" type="submit">Logout</button>
        </form>
      </div>
    </nav>

    <div class="content">
      <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
          <h1 style="margin: 0;">👥 User Management</h1>
          <button class="btn btn-primary" onclick="showCreateUserModal()">
            ➕ Create User
          </button>
        </div>

        <% if (message) { %>
          <div class="alert-success mb-4">
            <%= message %>
          </div>
        <% } %>

        <% if (error) { %>
          <div class="alert-error mb-4">
            <%= error %>
          </div>
        <% } %>

        <table class="users-table">
          <thead>
            <tr>
              <th>Username</th>
              <th>Role</th>
              <th>Created</th>
              <th>Last Login</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(user => { %>
              <tr>
                <td><strong><%= user.username %></strong></td>
                <td>
                  <span class="role-badge role-<%= user.role %>"><%= user.role %></span>
                </td>
                <td><%= new Date(user.created_at).toLocaleDateString() %></td>
                <td><%= user.last_login ? new Date(user.last_login).toLocaleString() : 'Never' %></td>
                <td>
                  <% if (user.username !== username) { %>
                    <button class="btn btn-secondary btn-small" onclick="showResetPasswordModal('<%= user.username %>')">
                      🔑 Reset
                    </button>
                    <button class="btn btn-secondary btn-small" onclick="confirmDelete('<%= user.username %>')">
                      🗑️ Delete
                    </button>
                    <% if (user.role === 'user') { %>
                      <button class="btn btn-primary btn-small" onclick="makeAdmin('<%= user.username %>')">
                        ⬆️ Make Admin
                      </button>
                    <% } else { %>
                      <button class="btn btn-secondary btn-small" onclick="makeUser('<%= user.username %>')">
                        ⬇️ Make User
                      </button>
                    <% } %>
                  <% } else { %>
                    <a href="/change-password" class="btn btn-secondary btn-small">🔐 Change</a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Create User Modal -->
  <div id="createUserModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeCreateUserModal()">&times;</span>
      <h2 style="margin-top: 0;">Create New User</h2>
      <form method="post" action="/users/create">
        <div class="form-group">
          <label>Username</label>
          <input name="username" required minlength="3" maxlength="50" pattern="[a-zA-Z0-9_-]+" 
                 placeholder="alphanumeric, dashes, underscores" />
        </div>
        <div class="form-group">
          <label>Password</label>
          <input name="password" type="password" required minlength="8" placeholder="min 8 characters" />
        </div>
        <div class="form-group">
          <label>Role</label>
          <select name="role" required>
            <option value="user">User</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <button class="btn btn-primary w-full" type="submit">Create User</button>
      </form>
    </div>
  </div>

  <!-- Reset Password Modal -->
  <div id="resetPasswordModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeResetPasswordModal()">&times;</span>
      <h2 style="margin-top: 0;">🔑 Reset User Password</h2>
      <p style="color: var(--text-muted); margin-bottom: 20px;">Set a new password for user: <strong id="resetUsername"></strong></p>
      <form method="post" action="/users/reset-password">
        <input type="hidden" name="username" id="resetUsernameInput" />
        <div class="form-group">
          <label>New Password</label>
          <input name="newPassword" type="password" required minlength="8" placeholder="min 8 characters" />
        </div>
        <div class="form-group">
          <label>Confirm Password</label>
          <input name="confirmPassword" type="password" required minlength="8" placeholder="confirm password" />
        </div>
        <button class="btn btn-primary w-full" type="submit">Reset Password</button>
      </form>
    </div>
  </div>

  <script>
    function showCreateUserModal() {
      document.getElementById('createUserModal').style.display = 'block';
    }

    function closeCreateUserModal() {
      document.getElementById('createUserModal').style.display = 'none';
    }

    function showResetPasswordModal(username) {
      document.getElementById('resetUsername').textContent = username;
      document.getElementById('resetUsernameInput').value = username;
      document.getElementById('resetPasswordModal').style.display = 'block';
    }

    function closeResetPasswordModal() {
      document.getElementById('resetPasswordModal').style.display = 'none';
    }

    window.onclick = function(event) {
      const createModal = document.getElementById('createUserModal');
      const resetModal = document.getElementById('resetPasswordModal');
      if (event.target === createModal) {
        createModal.style.display = 'none';
      }
      if (event.target === resetModal) {
        resetModal.style.display = 'none';
      }
    }

    function confirmDelete(username) {
      if (confirm(`Are you sure you want to delete user "${username}"?`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/users/delete';
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'username';
        input.value = username;
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
      }
    }

    function makeAdmin(username) {
      if (confirm(`Grant admin privileges to "${username}"?`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/users/update-role';
        const inputUser = document.createElement('input');
        inputUser.type = 'hidden';
        inputUser.name = 'username';
        inputUser.value = username;
        const inputRole = document.createElement('input');
        inputRole.type = 'hidden';
        inputRole.name = 'role';
        inputRole.value = 'admin';
        form.appendChild(inputUser);
        form.appendChild(inputRole);
        document.body.appendChild(form);
        form.submit();
      }
    }

    function makeUser(username) {
      if (confirm(`Revoke admin privileges from "${username}"?`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/users/update-role';
        const inputUser = document.createElement('input');
        inputUser.type = 'hidden';
        inputUser.name = 'username';
        inputUser.value = username;
        const inputRole = document.createElement('input');
        inputRole.type = 'hidden';
        inputRole.name = 'role';
        inputRole.value = 'user';
        form.appendChild(inputUser);
        form.appendChild(inputRole);
        document.body.appendChild(form);
        form.submit();
      }
    }
  </script>
</body>
</html>
