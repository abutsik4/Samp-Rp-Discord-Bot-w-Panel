            <label class="permission-item" data-perm="send_messages">
              <input type="checkbox" name="perm_send_messages" value="1" hidden>
              <div class="permission-toggle"></div>
              <span class="permission-label">Send Messages</span>
            </label>
            <label class="permission-item" data-perm="view_analytics">
              <input type="checkbox" name="perm_view_analytics" value="1" hidden>
              <div class="permission-toggle"></div>
              <span class="permission-label">View Analytics</span>
            </label>
            <label class="permission-item" data-perm="manage_bot">
              <input type="checkbox" name="perm_manage_bot" value="1" hidden>
              <div class="permission-toggle"></div>
              <span class="permission-label">Manage Bot Settings</span>
            </label>
            <label class="permission-item" data-perm="edit_library">
              <input type="checkbox" name="perm_edit_library" value="1" hidden>
              <div class="permission-toggle"></div>
              <span class="permission-label">Edit Message Library</span>
            </label>
            <label class="permission-item" data-perm="view_debug">
              <input type="checkbox" name="perm_view_debug" value="1" hidden>
              <div class="permission-toggle"></div>
              <span class="permission-label">View Debug Logs</span>
            </label>
            <label class="permission-item" data-perm="schedule_messages">
              <input type="checkbox" name="perm_schedule_messages" value="1" hidden>
              <div class="permission-toggle"></div>
              <span class="permission-label">Schedule Messages</span>
            </label>
            <label class="permission-item" data-perm="export_data">
